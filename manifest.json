{
  "manifest_version": 3,
  "name": "Süzgeç — Akıllı Reklam Engelleyici",
  "short_name": "Süzgeç",
  "version": "1.0.0",
  "description": "Reklamları, popunder'ları ve görünmez tıklama tuzaklarını engeller; yeni reklam alan adlarını kendiliğinden öğrenir.",
  "minimum_chrome_version": "118",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "scripting",
    "activeTab",
    "webNavigation"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "build/background.js",
    "type": "module"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "filters",
        "enabled": true,
        "path": "rules/filters.json"
      },
      {
        "id": "privacy",
        "enabled": true,
        "path": "rules/privacy.json"
      },
      {
        "id": "annoyances",
        "enabled": true,
        "path": "rules/annoyances.json"
      },
      {
        "id": "trackers",
        "enabled": true,
        "path": "rules/trackers.json"
      }
    ]
  },
  "action": {
    "default_title": "Süzgeç",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "redirects/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
